# RescueAI backend works with these defaults; no .env file is required for local use.
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATA_FILE=./data/rescueai.json
UPLOAD_DIR=./uploads

# Optional production integrations
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RescueAI <no-reply@rescueai.local>
DEV_OTP=123456
